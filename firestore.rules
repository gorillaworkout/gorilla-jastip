rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function validMonthlyExpense() {
      return request.resource.data.keys().hasOnly(['name', 'amount', 'category', 'date', 'description', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000000
        && request.resource.data.category is string
        && request.resource.data.category in ['kos', 'jajan', 'coffeeshop', 'utang', 'makan', 'transport', 'shopping', 'entertainment', 'health', 'education', 'other']
        && request.resource.data.date is timestamp
        && (!request.resource.data.keys().hasAny(['description'])
          || (request.resource.data.description is string && request.resource.data.description.size() <= 500))
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.role == "user";
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /periods/{document} {
      allow read, write: if isAdmin();
    }
    match /periodItems/{document} {
      allow read, write: if isAdmin();
    }
    match /expenses/{document} {
      allow read, write: if isAdmin();
    }
    match /incomes/{document} {
      allow read, write: if isAdmin();
    }

    match /monthly-expenses/{document} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validMonthlyExpense();
      allow delete: if isAdmin();
    }

    match /jastipers/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /departure_trips/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Personal finance remains owned by its Firebase UID, independent of admin role.
    match /financeUsers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{subcollection}/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Workspace tim Jastip Cina: super admin atau email terdaftar di cina-team.
    function isChinaTeam() {
      return request.auth != null
        && (isAdmin() || exists(/databases/$(database)/documents/cina-team/$(request.auth.token.email)));
    }

    match /cina-orders/{document} {
      allow read, write: if isChinaTeam();
    }
    match /cina-counters/{document} {
      allow read, write: if isChinaTeam();
    }
    match /cina-team/{document} {
      allow read: if isChinaTeam();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
